    {
      "name": "processed_records_by_layer",
      "displayName": "Processed Records by Layer",
      "config": {
        "version": "1.1",
        "source": "WITH bronze_records AS (\n  SELECT 'Bronze' AS layer, 'merchants' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.bronze.merchants\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Bronze' AS layer, 'transactions' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.bronze.transactions\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Bronze' AS layer, 'users' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.bronze.users\n  GROUP BY _ingested_at\n), silver_records AS (\n  SELECT 'Silver' AS layer, 'merchants_silver' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.silver.merchants_silver\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Silver' AS layer, 'transactions_silver' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.silver.transactions_silver\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Silver' AS layer, 'users_silver' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.silver.users_silver\n  GROUP BY _ingested_at\n), gold_records AS (\n  SELECT 'Gold' AS layer, 'dim_channel' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.gold.dim_channel\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Gold' AS layer, 'dim_date' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.gold.dim_date\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Gold' AS layer, 'dim_merchant' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.gold.dim_merchant\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Gold' AS layer, 'dim_user' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.gold.dim_user\n  GROUP BY _ingested_at\n  UNION ALL\n  SELECT 'Gold' AS layer, 'fact_transactions' AS table_name, _ingested_at, COUNT(*) AS record_count\n  FROM fintech_finpay.gold.fact_transactions\n  GROUP BY _ingested_at\n) SELECT * FROM bronze_records UNION ALL SELECT * FROM silver_records UNION ALL SELECT * FROM gold_records\n",
        "dimensions": [
          {
            "name": "layer",
            "expr": "layer",
            "displayName": "Layer"
          },
          {
            "name": "table_name",
            "expr": "table_name",
            "displayName": "Table Name"
          },
          {
            "name": "ingested_at",
            "expr": "_ingested_at",
            "displayName": "Ingested At"
          }
        ],
        "measures": [
          {
            "name": "total_records",
            "expr": "SUM(record_count)",
            "displayName": "Total Records"
          },
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
